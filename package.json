{
  "name": "soldatouch-validation",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node --test tests/visao-mobile.browser.cjs tests/simulacao.browser.cjs",
    "start": "node scripts/soldatech.cjs",
    "test:python": "python -m unittest discover -s tests -p test_visao.py",
    "build:pages": "node scripts/build-pages.cjs",
    "validate:pages": "node scripts/validate-pages.cjs",
    "test:pages": "npm run build:pages && npm run validate:pages && node --test tests/pages.browser.cjs"
  },
  "devDependencies": {
    "mqtt": "5.16.0",
    "node-red": "5.0.8",
    "playwright": "1.64.0"
  },
  "dependencies": {
    "modbus-serial": "8.0.23"
  },
  "engines": {
    "node": ">=22"
  }
}
